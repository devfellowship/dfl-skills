# Registry API. Defaults to production when unset.
VITE_API_BASE=https://skills.devfellowship.com

# DFL Supabase project — powers "Sign in with DevFellowship", which is what
# unlocks the internal skills. Both values are public by design: the anon key is
# the publishable key and access is decided by RLS on the DFL member tables.
# Leave them unset and the sign-in button simply doesn't render.
# NEVER put the service_role key here: anything VITE_* ships in the bundle.
VITE_SUPABASE_URL=https://yoojxnggaxcqtsyjdrdx.supabase.co
VITE_SUPABASE_ANON_KEY=
